---
import { contactEmail, contactPhone, facebookUrl, instagramUrl, linkedinUrl, units, whatsappUrl } from '../data/site';

/* Estrutura de três colunas do rodapé de referência (2026-10-26): marca e
   aviso legal à esquerda, lojas no meio, contato e redes à direita. O rodapé
   anterior tinha Menu e os ícones de IA ("Pergunte às IAs sobre a PPD"); os
   dois saíram — o site agora fala com parceiros, não com o consumidor que
   quer conferir a loja. "Nos acompanhe" traz Instagram, Facebook e LinkedIn,
   os mesmos três do rodapé do site antigo. */

const redes = [
  { label: 'Instagram', href: instagramUrl, icon: '/assets/icon-instagram.svg' },
  { label: 'Facebook', href: facebookUrl, icon: '/assets/icon-facebook.svg' },
  { label: 'LinkedIn', href: linkedinUrl, icon: '/assets/icon-linkedin.svg' },
];
---

<footer class="footer" id="rodape">
  <hr class="footer__rule" />

  <div class="footer__grid">
    <div class="footer__brand">
      <img
        src="/assets/logo-ppd-apple-white.svg"
        alt="Pede Pro Dindo — Revendedor autorizado Apple"
        width="626"
        height="237"
        class="footer__logo"
      />

      <div class="footer__legal">
        <p>PPD COMERCIO DE ELETRONICOS LTDA<br />CNPJ 32.819.954/0001-17</p>
        <p>© 2026 Todos os direitos reservados.</p>
      </div>
    </div>

    <div class="footer__col">
      <h2 class="footer__title">Lojas físicas</h2>
      <ul class="footer__units">
        {units.map((unit) => (
          <li>
            <span class="footer__unit-city">{unit.city} – RS</span>
            <p>{unit.address}</p>
          </li>
        ))}
      </ul>
    </div>

    <div class="footer__col footer__col--contact">
      <div class="footer__contact">
        <h2 class="footer__title">
          <span class="footer__title-soft">Dúvidas ou sugestões?</span><br />
          Entre em contato conosco:
        </h2>
        <ul class="footer__stack">
          <li>
            <a href={`mailto:${contactEmail}`} class="footer__link">
              <img src="/assets/icon-email.svg" alt="" width="24" height="24" />
              {contactEmail}
            </a>
          </li>
          <li>
            <a href={whatsappUrl} target="_blank" rel="noopener" class="footer__link">
              <img src="/assets/icon-whatsapp.svg" alt="" width="24" height="24" />
              {contactPhone}
            </a>
          </li>
        </ul>
      </div>

      <div class="footer__social">
        <h2 class="footer__title">Nos acompanhe:</h2>
        <ul class="footer__networks">
          {redes.map((rede) => (
            <li>
              <a href={rede.href} target="_blank" rel="noopener" aria-label={`${rede.label} da Pede Pro Dindo (abre em nova aba)`}>
                <img src={rede.icon} alt="" width="24" height="24" />
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* TODO: página de políticas de privacidade ainda não existe. */}
      <a href="#" class="footer__privacy">Políticas de Privacidade</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: var(--space-lg) var(--space-md);
    /* Mesmo `#F6F6F6` do FAQ (`--color-card`): as duas seções são uma faixa
       só, e a régua do topo é o que marca onde o rodapé começa. */
    background: var(--color-card);
    color: var(--color-black);
  }

  .footer__rule {
    width: 100%;
    height: 0;
    margin: 0;
    border: 0;
    border-top: 1px solid var(--color-rule);
  }

  /* Abaixo de 60rem as três colunas empilham na ordem do HTML: marca, lojas,
     contato. O layout lado a lado foi desenhado em 1440. */
  .footer__grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  @media (min-width: 60rem) {
    .footer__grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      column-gap: var(--space-md);
      align-items: stretch;
    }
  }

  /* Logo no topo, aviso legal colado embaixo: `space-between` dá a mesma
     distribuição do desenho, e a coluna estica até a altura da mais alta. */
  .footer__brand {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-md);
  }

  /* O arquivo é o logo `fill="white"` do hero; sobre o fundo claro ele vira
     preto por filtro, sem um segundo asset para manter em sincronia. */
  .footer__logo {
    width: max(6.5rem, 4.319vw + 5.4877rem); /* 150px @1440, piso 104px @375 — escala fluida sem teto */
    height: auto;
    filter: brightness(0);
  }

  .footer__legal {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    font-size: var(--fs-label);
    line-height: 1.5;
    color: var(--color-footer-faint);
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-list);
  }

  /* Contato e redes juntos no alto; a política de privacidade desce para a
     base da coluna, na altura do aviso legal da coluna da marca. */
  .footer__col--contact {
    gap: var(--space-sm); /* 32px @1440 */
  }

  .footer__privacy {
    margin-top: auto;
    font-size: var(--fs-label);
    line-height: 1.5;
    color: var(--color-footer-faint);
  }

  .footer__privacy:hover {
    color: var(--color-black);
  }

  .footer__title {
    font-size: var(--fs-card);
    font-weight: 600;
    line-height: 1.3;
  }

  .footer__title-soft {
    font-weight: 400;
  }

  .footer__units {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .footer__unit-city {
    font-size: var(--fs-nav);
    font-weight: 600;
    line-height: 1.3;
  }

  .footer__units p {
    font-size: var(--fs-nav);
    line-height: 1.3;
  }

  .footer__contact,
  .footer__social {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .footer__stack {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .footer__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--fs-nav);
    line-height: 1.3;
  }

  .footer__link:hover {
    color: var(--color-ink-soft);
  }

  /* Os ícones vêm em branco, para fundo escuro; `brightness(0)` os leva a
     preto sem editar os SVGs. */
  .footer__link img,
  .footer__social img {
    width: max(.875rem, 0.188vw + .831rem); /* 16px @1440, piso 14px @375 — escala fluida sem teto */
    height: auto;
    filter: brightness(0);
  }

  .footer__networks {
    display: flex;
    gap: var(--space-2xs);
  }
</style>
