---
import { faq } from '../data/faq';

/* `<details>` e não um acordeão em JS: a resposta fica no HTML servido esteja
   a linha aberta ou fechada, então rastreador, leitor de tela e LLM leem as
   oito respostas inteiras sem executar nada. `name` agrupa as oito num
   acordeão exclusivo, como em Unidades — sem uma linha de script. */

/* O mesmo conteúdo, de novo, em JSON-LD: o `<details>` resolve quem lê a
   página, isto resolve quem lê o markup em busca de dados estruturados. */
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer.trim(),
    },
  })),
};
---

<section class="faq" id="faq">
  <div class="faq__row">
    <span class="faq__label">Perguntas frequentes</span>

    <div class="faq__content">
      <h2 class="faq__headline">O que você precisa saber antes de comprar</h2>

      {/* Régua cheia entre o título e a lista, como no frame do Figma. */}
      <hr class="faq__rule" />

      <ul class="faq__list">
        {faq.map((item, index) => (
          <li>
            {/* A primeira nasce aberta: fechadas, as oito linhas leem como uma
                lista de links e nada denuncia que há resposta atrás. */}
            <details class="faq__item" name="faq" open={index === 0}>
              <summary class="faq__question">{item.question}</summary>
              <div class="faq__answer" set:html={item.answer} />
            </details>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

<style>
  .faq {
    /* 128px em cima e embaixo, 64px nas laterais — o mesmo par de Unidades e
       Depoimentos. */
    padding: var(--space-lg) var(--space-md);
    /* Claro desde 2026-09-08: o Figma trouxe FAQ e rodapé para o mesmo
       #F6F6F6 (`--color-card`), encerrando a fase escura da inversão de
       2026-09-04. */
    background: var(--color-card);
  }

  .faq__row {
    display: grid;
    gap: var(--space-faq-row);
  }

  /* Mudança de comportamento: abaixo disso o rótulo e o conteúdo não cabem
     lado a lado sem a coluna de texto perder medida de leitura.

     As duas colunas são fixas e sobra folga à direita no frame de 1440 — é a
     composição assimétrica do Figma, não engano. Em 706px a resposta dá ~88
     caracteres por linha; deixar a coluna crescer até o fim passaria de 110. */
  @media (min-width: 60rem) {
    .faq__row {
      grid-template-columns: var(--w-faq-head) var(--w-faq-body);
      align-items: start;
    }
  }

  .faq__label {
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-faq-label);
  }

  .faq__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  /* A caixa do título mede em `em`, e não em `vw`: quantas linhas ele ocupa é
     a razão entre a largura da caixa e o corpo, então amarrar uma coisa na
     outra segura as duas linhas desenhadas enquanto a coluna couber — com uma
     medida em viewport a quebra voltaria a três em telas médias, onde o corpo
     encolhe mais devagar que a largura. 13.5em = 567px em 1440; a quebra boa
     ("O que você precisa saber" / "antes de comprar") pede 530.

     O frame do Figma estreitou para 489px na revisão de 2026-09-08, mirando
     "O que você precisa" / "saber antes de comprar" — mas essa quebra pede
     um `<br>` manual (o navegador compõe "saber antes de comprar" mais largo
     que "O que você precisa" e não quebra ali), e a headline do FAQ é de
     propósito o caso que evita esse mecanismo. As duas linhas equivalentes
     acima seguem valendo. */
  .faq__headline {
    max-width: 13.5em;
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-black);
  }

  .faq__rule {
    width: 100%;
    height: 0;
    margin: 0;
    border: 0;
    border-top: 1px solid var(--color-rule);
  }

  .faq__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    /* 12px do Figma: acerta a primeira pergunta com a primeira linha do
       título, que é bem maior. */
    padding-top: var(--space-2xs);
  }

  /* A régua é a borda do item, não um elemento entre pergunta e resposta: ela
     fecha o item inteiro, e a distância até ela muda com o estado — 12px
     abaixo da pergunta fechada, 24px abaixo da resposta aberta. */
  .faq__item {
    padding-bottom: var(--space-2xs);
    border-bottom: 1px solid var(--color-rule);
  }

  .faq__item[open] {
    padding-bottom: var(--space-list);
  }

  .faq__question {
    display: flex;
    align-items: center;
    font-size: var(--fs-question);
    /* Fechada, a pergunta é Medium; aberta, sobe para SemiBold — o Figma não
       desenha marcador nenhum, então o peso é o único sinal de estado. */
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-black);
    cursor: pointer;
    list-style: none;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question:focus-visible {
    outline: 2px solid var(--color-black);
    outline-offset: 4px;
  }

  .faq__item[open] .faq__question {
    font-weight: 600;
  }

  .faq__answer {
    /* `padding`, não `margin`: o vão até a pergunta precisa ficar dentro da
       caixa que a abertura recolhe, senão sobra uma faixa quando fechada. */
    padding-top: var(--space-list);
    font-size: var(--fs-card);
    line-height: 1.5;
    color: var(--color-text-mid);
  }

  /* Abertura suave, sem JS: `::details-content` — a caixa que o navegador
     mostra e esconde — vira uma grade de uma linha que cresce de 0fr a 1fr,
     e `content-visibility` acompanha numa transição discreta para o texto
     seguir visível enquanto recolhe. Navegador sem `::details-content`
     (anterior a ~2025) ignora tudo isto e abre/fecha na hora, como antes. */
  @media (prefers-reduced-motion: no-preference) {
    .faq__item {
      transition: padding-bottom 260ms ease;
    }

    .faq__item::details-content {
      display: grid;
      grid-template-rows: 0fr;
      transition:
        grid-template-rows 260ms ease,
        content-visibility 260ms allow-discrete;
    }

    .faq__item[open]::details-content {
      grid-template-rows: 1fr;
    }

    /* `min-block-size: 0` deixa a linha 0fr chegar a zero de fato (sem ele a
       faixa `auto` da grade segura a altura do conteúdo); `overflow` corta o
       que passa da linha enquanto ela cresce. */
    .faq__answer {
      min-block-size: 0;
      overflow: hidden;
    }
  }

  /* `:global()` porque o conteúdo entra por `set:html`: os elementos vêm da
     string em `faq.ts` e nunca recebem o atributo de escopo do Astro, então
     um seletor descendente comum não os alcançaria. O escopo continua preso
     ao `.faq__answer` à esquerda. */
  .faq__answer :global(p + p),
  .faq__answer :global(ul),
  .faq__answer :global(ul + p) {
    margin-top: var(--space-2xs);
  }

  /* Lista com marcador pendurado, como no frame. `display: flex` some com o
     `::marker`, então aqui é bloco e o respiro entre itens sai da margem. */
  .faq__answer :global(ul) {
    padding-left: 1.4em;
    list-style: disc;
  }

  .faq__answer :global(li + li) {
    margin-top: var(--space-3xs);
  }

  /* O Figma deixa o negrito na mesma cor do corpo — só o peso muda. */
  .faq__answer :global(strong) {
    font-weight: 600;
  }
</style>
