---
/* Cada oferta ganhou ícone no Figma (2026-09-03). São `<img>`, e não SVG
   inline como o do antigo rótulo da seção: o traço é preto sobre branco e
   fica preto — nada aqui precisa herdar cor de contexto. */
const offers = [
  {
    label: 'Compre',
    text: 'iPhones seminovos revisados por especialistas, com até 24 meses de garantia.',
    icon: '/assets/icon-compre.svg',
  },
  {
    label: 'Troque',
    text: 'seu modelo atual pagando apenas a diferença. Avaliamos na hora.',
    icon: '/assets/icon-troque.svg',
  },
  {
    label: 'Venda',
    text: 'seu celular para a Pede Pro Dindo, avaliação e pagamento realizados na hora.',
    icon: '/assets/icon-venda.svg',
  },
];
---

{/* A seção era preta, com um rótulo "Economia circular" e o ícone do ciclo
    no topo. O Figma inverteu para branco e tirou os dois: agora a headline
    é o único título, e ela passou para a direita, com as três ofertas na
    coluna estreita da esquerda. */}
<section class="circular" id="economia-circular">
  <div class="circular__content">
    {/* Headline antes das ofertas no HTML — é o título da seção, e quem lê
        por leitor de tela ou sem CSS a encontra primeiro. A troca de lado
        acontece só na grade, no desktop. */}
    <h2 class="circular__headline">
      <strong>A partir da economia circular,</strong> democratizamos o acesso <br />
      a dispositivos de alto nível <br />
      com celulares <strong>seminovos, revisados e com garantia.</strong>
    </h2>

    <ul class="circular__offers">
      {offers.map((offer) => (
        <li>
          <img src={offer.icon} alt="" width="24" height="24" class="circular__icon" />
          <p><strong>{offer.label}</strong> {offer.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .circular {
    padding: var(--space-lg) var(--space-md);
    background: var(--color-white);
  }

  .circular__content {
    display: grid;
    gap: var(--space-block);
  }

  /* Mudança de comportamento: as duas colunas só coexistem com espaço para a
     coluna de ofertas manter medida de leitura. Acima disso a headline vai
     para a direita, como no Figma, e as ofertas ficam centradas na altura
     dela. */
  @media (min-width: 60rem) {
    .circular__content {
      grid-template-columns: var(--w-offers) minmax(0, 1fr);
      gap: var(--space-lg);
      align-items: center;
    }

    .circular__headline {
      grid-area: 1 / 2;
    }

    .circular__offers {
      grid-area: 1 / 1;
    }
  }

  /* Largura em `em`, como no hero: ela escala junto com a própria fonte, e a
     caixa do Figma (833px a 58px = 14.362em) se reproduz em qualquer
     resolução. As duas quebras marcadas no HTML são as do Figma; a terceira
     ("com celulares seminovos, / revisados e com garantia.") é a quebra
     natural dentro desta largura — o Figma também a deixa acontecer sozinha.

     Abaixo de ~1400px a coluna da grade fica mais estreita que esta medida e
     o texto ganha uma linha a mais: os tokens fluidos não são proporcionais
     (têm um termo constante), então a fonte encolhe mais devagar que a
     coluna. É reflow, não corte. */
  .circular__headline {
    max-width: 14.362em;
    font-size: var(--fs-h1);
    line-height: 1.25;
    font-weight: 400;
    color: var(--color-black);
  }

  .circular__headline strong {
    font-weight: 600;
  }

  .circular__offers {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .circular__offers li {
    display: flex;
    flex-direction: column;
    gap: max(.75rem, 0.376vw + .662rem); /* 16px @1440 — escala fluida sem teto, ver CLAUDE.md */
  }

  .circular__icon {
    width: max(1.25rem, 0.376vw + 1.162rem); /* 24px @1440 — escala fluida sem teto, ver CLAUDE.md */
    height: auto;
  }

  .circular__offers p {
    font-size: var(--fs-card);
    line-height: 1.5;
    color: var(--color-text-mid);
  }

  .circular__offers strong {
    font-weight: 600;
    color: var(--color-black);
  }
</style>
