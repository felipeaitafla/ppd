---
import { instagramHandle, instagramUrl } from '../data/site';
import { getInstagramPosts } from '../data/instagram';

/* Assuntos que o perfil publica, como no Figma. Não são filtros: a grade
   abaixo é uma só. */
const topics = ['Dicas', 'Ofertas', 'Bastidores', 'Humor', 'Novidades Apple'];

/* Seis últimas publicações reais da matriz, buscadas em tempo de build pela
   Graph API (ver `src/data/instagram.ts`). Se a busca falhar — token
   vencido, API fora do ar —, `posts` vem vazio e a grade cai para os seis
   quadrados cinzas de reserva, que seguram a medida da seção. */
const posts = await getInstagramPosts(6);

/* A legenda vira o alt, limpa: sem emoji nem quebra de linha (que o leitor de
   tela soletra ou engole) e cortada na última palavra inteira até 140
   caracteres, em vez de no meio de uma. */
const altFromCaption = (caption: string) => {
  const clean = caption
    .replace(/[\p{Extended_Pictographic}\u{FE0F}\u{200D}]/gu, '')
    .replace(/\s+/g, ' ')
    .trim();
  if (clean.length <= 140) return clean;
  return `${clean.slice(0, 140).replace(/\s+\S*$/, '')}…`;
};
---

<section class="insta" id="insta">
  <div class="insta__head">
    <a class="insta__handle" href={instagramUrl} target="_blank" rel="noopener noreferrer">
      {instagramHandle}<span class="visually-hidden"> (abre em nova aba)</span>
    </a>
    {/* Quebra do frame `84:162` travada à mão, como no hero: a caixa em `em`
        deixava a frase cair para três linhas (e os badges para duas) em
        telas largas, onde o corpo cresce mais rápido que a razão caixa/letra.
        Abaixo de 60rem — onde o cabeçalho deixa de medir `max-content` — o
        `<br>` some e o texto quebra à vontade; o espaço depois dele é o que
        mantém a frase inteira. */}
    <h2>Siga-nos no Instagram e fique<br class="quebra" /> por dentro das novidades</h2>

    <ul class="insta__topics">
      {topics.map((topic) => <li>{topic}</li>)}
    </ul>
  </div>

  {posts.length > 0 ? (
    <div class="insta__grid">
      {posts.map((post) => (
        <a
          class="insta__post"
          href={post.permalink}
          target="_blank"
          rel="noreferrer noopener"
        >
          <img
            src={post.imageUrl}
            alt={altFromCaption(post.caption) || `Publicação de ${instagramHandle} no Instagram`}
            loading="lazy"
            decoding="async"
          />
        </a>
      ))}
    </div>
  ) : (
    /* Escondida de leitor de tela: seis caixas vazias não dizem nada a quem
       não as vê. Reserva de layout para quando a Graph API falhar. */
    <div class="insta__grid" aria-hidden="true">
      {Array.from({ length: 6 }, () => <div class="insta__post" />)}
    </div>
  )}
</section>

<style>
  /* Mesmo gabarito da seção Autorizada — coluna centrada, 128px de respiro em
     cima e embaixo. O Figma não põe padding lateral; aqui ele entra só para
     os quadrados não encostarem na borda abaixo de 60rem, onde a grade passa
     a ocupar a largura toda. */
  .insta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    width: 100%;
    padding: var(--space-lg) var(--space-md);
    background: var(--color-white);
  }

  .insta__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-list);
    width: 100%;
    text-align: center;
  }

  /* No desktop o bloco mede `max-content` — a fileira inteira de badges, a
     linha mais larga — para não encolher até a maior linha do `h2` e forçar
     os badges a quebrar; `h2` e badges centralizam dentro dela. Abaixo de
     60rem volta a 100% e os badges quebram à vontade, como no mobile. */
  @media (min-width: 60rem) {
    .insta__head {
      width: max-content;
      max-width: 100%;
    }
  }

  /* O rótulo da seção é o próprio handle, e é o único jeito de seguir o perfil
     a partir daqui: a seção convida e o Figma não desenhou botão. Como link,
     desenha igual — cor, corpo e caixa alta são os mesmos dos outros rótulos. */
  .insta__handle {
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-label);
  }

  .insta__head h2 {
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: 1.25;
  }

  /* Sem clique, como as pastilhas de cidade em Depoimentos: são `li` para nada
     se anunciar como acionável. */
  .insta__topics {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2xs) var(--space-list);
  }

  .insta__topics li {
    padding: var(--space-3xs) var(--space-list);
    font-size: var(--fs-nav);
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-ink-soft);
    background: var(--color-card);
    border-radius: var(--radius);
  }

  /* Duas colunas no mobile; a partir de 60rem vira 3×2, como no frame `84:174`
     do Figma (duas fileiras de três) — abaixo disso três colunas espremeriam
     demais os seis quadrados na largura estreita.

     A partir de 60rem a grade mede 60vw — os 864px em 1440 do frame `84:174`,
     que são 60% da largura —, crescendo com a tela sem teto, como o resto do
     site desde 2026-09-08. Abaixo disso ocupa a largura toda (menos o respiro
     lateral), com um teto de 36rem que casa com 60vw exatamente aos 60rem,
     sem salto na troca. */
  .insta__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2xs);
    width: 100%;
    max-width: 36rem;
  }

  @media (min-width: 60rem) {
    .insta__grid {
      grid-template-columns: repeat(3, 1fr);
      width: 60vw;
      max-width: none;
    }
  }

  /* 1080×1440: a proporção de retrato que a Meta aceita em publicações,
     não o quadrado 1:1 do grid antigo do Instagram. */
  .insta__post {
    display: block;
    aspect-ratio: 1080 / 1440;
    overflow: hidden;
    background: var(--color-placeholder);
    border-radius: var(--radius);
  }

  .insta__post img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Abaixo de 60rem o cabeçalho volta a 100% e não há mais espaço garantido
     para a linha "Siga-nos no Instagram e fique": a quebra manual sai e o
     texto quebra sozinho na largura que houver. */
  @media (max-width: 59.99rem) {
    .quebra {
      display: none;
    }
  }
</style>
