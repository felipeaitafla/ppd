---

{/* Trilho e pino existem para a seção prender: o pino gruda na tela e o
    trilho, mais alto que ele exatamente na medida do que sobra do carrossel,
    dá à página o percurso que o script converte em rolagem lateral. Sem JS
    ligado, os dois são `div`s comuns e a seção fica como sempre foi. */}
<section class="depos" data-secao>
  <div class="depos__trilho" data-trilho>
    <div class="depos__pino" data-pino>
      <div class="depos__head">
        <span class="depos__label">Depoimentos</span>
        <div class="depos__title">
          <h2>+4000 avaliações 5 estrelas no Google</h2>
          <div class="depos__rating">
            <img
              src="/assets/icon-google.svg"
              alt="Google"
              width="25"
              height="26"
            />
            <img
              src="/assets/icon-stars.svg"
              alt="Nota 5 de 5"
              width="127"
              height="22"
              class="depos__stars"
            />
          </div>
        </div>
      </div>

      <div class="depos__body">
        <div class="depos__bar">
          <ul class="depos__cities">
            {cities.map((city) => (
              <li>
                {city.filter ? (
                  <button
                    type="button"
                    class:list={['pill', { 'is-active': city.name === initialCity }]}
                    data-cidade={city.name}
                    aria-pressed={city.name === initialCity ? 'true' : 'false'}
                  >
                    {city.name}
                  </button>
                ) : (
                  <span class="pill">{city.name}</span>
                )}
              </li>
            ))}
          </ul>
          {/* Um botão por cidade, só o da ativa aparece. Santo Ângelo ainda
              não tem URL do perfil (sem href vira `<p>`, ver Button). */}
          {cities.filter((c) => c.filter).map((city) => (
            <div data-google={city.name} hidden={city.name !== initialCity}>
              <Button href={city.reviewUrl} newTab={!!city.reviewUrl}>Acessar Google Review</Button>
            </div>
          ))}
        </div>

        {/* Focável de propósito: com a barra de rolagem escondida, o teclado
            só alcança a faixa se ela puder receber foco — daí as setas rolam
            os cartões como rolariam qualquer região com overflow. */}
        <ul
          class="depos__row"
          data-carrossel
          tabindex="0"
          aria-label="Depoimentos de clientes"
        >
          {reviews.map((review) => (
            <li class="depo" data-cidade={review.city} hidden={review.city !== initialCity}>
              <div class="depo__quote"><p>{review.text}</p></div>
              <div class="depo__by">
                {review.avatar ? (
                  <Image
                    src={review.avatar}
                    alt=""
                    width={80}
                    format="webp"
                    quality={80}
                    loading="lazy"
                    class="depo__avatar"
                  />
                ) : (
                  <span class="depo__avatar depo__avatar--inicial" aria-hidden="true">
                    {review.name[0]}
                  </span>
                )}
                <span>{review.name}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .depos {
    /* 128px em cima e embaixo, 64px nas laterais — o mesmo par de Unidades e
       do FAQ. */
    padding: var(--space-lg) var(--space-md);
    background: var(--color-white);
  }

  .depos__pino {
    display: flex;
    flex-direction: column;
    gap: var(--space-block);
    /* Container de consulta para o `cqi` do `@media (min-width: 90rem)` lá
       embaixo — mesmo mecanismo da economia circular, ver o comentário
       longo ali. `.depos` não tem teto de largura (sem `max-width`), então
       esta caixa já cresce quase 1:1 com a tela; é essa proporção que o
       `cqi` lê. */
    container-type: inline-size;
  }

  /* Prender é decisão do script — só ele sabe quanto excedente há para
     percorrer —, então a classe, a altura do trilho e o `top` do pino saem
     todos de lá, de uma vez: CSS e JS nunca discordam sobre o percurso. */
  .depos.is-preso .depos__pino {
    position: sticky;
    top: var(--pino-topo, 0px);
  }

  .depos__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .depos__label {
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-label);
  }

  .depos__title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .depos__title h2 {
    /* Teto em `em`, não em `rem`: a caixa escala junto com a fonte, então o
       título cabe em uma linha em qualquer viewport onde sobre espaço ao
       lado da nota do Google — o teto de 710px do Figma quebrava em duas. */
    max-width: 24em;
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: 1.25;
  }

  .depos__rating {
    display: flex;
    align-items: center;
    gap: var(--space-list);
  }

  .depos__rating img {
    width: auto;
    height: max(1.125rem, 0.751vw + .9489rem); /* 26px @1440 — escala fluida sem teto, ver CLAUDE.md */
  }

  .depos__stars {
    height: max(.9375rem, 0.657vw + .7835rem); /* 22px @1440 — escala fluida sem teto, ver CLAUDE.md */
  }

  .depos__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-list);
  }

  .depos__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs);
  }

  /* Só as cidades com avaliações são botões; as demais ficam `li` simples,
     para nada anunciar-se como acionável enquanto não filtram de fato. */
  .depos__cities {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-list); /* 24px @1440 */
  }

  /* A pastilha inteira é o `.pill`: botão (cidade com avaliações) ou `span`
     (as demais). Borda de `--color-placeholder` (#e6e6e6; o Figma usava
     `#f4f4f4` a 30%, que sumia sobre o branco). */
  .depos__cities .pill {
    display: block;
    padding: var(--space-3xs) var(--space-list);
    font: inherit;
    font-size: var(--fs-nav);
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-pill);
    background: none;
    border: 1px solid var(--color-placeholder);
    border-radius: var(--radius);
  }

  .depos__cities button.pill {
    cursor: pointer;
  }

  .depos__cities button.pill:focus-visible {
    outline: 2px solid var(--color-black);
    outline-offset: 2px;
  }

  .depos__cities .pill.is-active {
    color: var(--color-ink-soft);
    background: var(--color-card);
    border-color: transparent;
    border-radius: var(--radius);
  }

  /* Mais respiro só no mobile (abaixo de 48rem, corte de sempre): na largura
     estreita o cabeçalho inteiro (rótulo, título, nota, pastilhas, botão,
     cartões) empilha em coluna única e ficava espremido; no desktop o layout
     já tem folga própria e os tokens base bastam. */
  @media (max-width: 47.99rem) {
    .depos__pino {
      gap: var(--space-xl);
    }

    .depos__body {
      gap: var(--space-xl);
    }

    .depos__bar {
      gap: var(--space-block);
    }

    .depos__cities {
      gap: var(--space-2xs) var(--space-sm);
    }
  }

  /* Cinco cartões de 376px não cabem em viewport nenhuma: a faixa rola na
     horizontal e sangra até a borda da seção, senão o corte do último
     cartão sugeriria que a lista acabou ali. */
  .depos__row {
    display: flex;
    gap: var(--space-2xs);
    overflow-x: auto;
    margin-inline: calc(var(--space-md) * -1);
    padding-inline: var(--space-md);
    scroll-padding-inline: var(--space-md);
    overscroll-behavior-x: contain;
    /* Barra escondida: com a seção presa, quem tem mouse anda a faixa
       rolando a própria página, e quem usa teclado alcança a faixa pelo
       foco — a barra só cobrava espaço embaixo dos cartões. */
    scrollbar-width: none;
  }

  .depos__row::-webkit-scrollbar {
    display: none;
  }

  .depos__row:focus-visible {
    /* Para dentro: a faixa sangra até a borda da tela e um contorno por
       fora ficaria metade cortado. */
    outline: 2px solid var(--color-black);
    outline-offset: -2px;
  }

  /* Snap só no toque — que é justamente onde a seção não prende: o dedo joga
     a faixa e ela precisa parar alinhada. No mouse quem escreve `scrollLeft`
     é o script, quadro a quadro, e o snap obrigatório puxaria cada passo de
     volta ao cartão mais próximo. */
  @media (pointer: coarse) {
    .depos__row {
      scroll-snap-type: x mandatory;
    }
  }

  .depo {
    flex: 0 0 var(--w-card);
    display: flex;
    flex-direction: column;
    border-radius: var(--radius);
    background: var(--color-card);
    scroll-snap-align: start;
  }

  /* O `display: flex` acima vence o `display: none` do navegador para
     `hidden`; sem esta linha o filtro por cidade não esconderia nada. */
  .depo[hidden] {
    display: none;
  }

  .depo__quote {
    min-height: max(9rem, 8.263vw + 7.0634rem); /* 232px @1440 — escala fluida sem teto, ver CLAUDE.md */
    padding: var(--space-sm);
    font-size: var(--fs-card);
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .depo__by {
    display: flex;
    align-items: center;
    gap: max(.625rem, 0.469vw + .515rem); /* 15px @1440 — escala fluida sem teto, ver CLAUDE.md */
    margin-top: auto;
    padding: var(--space-list) var(--space-sm);
    border-top: 1px solid var(--color-rule);
    font-size: var(--fs-card);
    font-weight: 500;
    color: var(--color-ink-soft);
  }

  /* Reserva para quem veio sem foto: a inicial num círculo, como o próprio
     Google faz. Sai quando a foto chegar (basta preencher `avatar`). */
  .depo__avatar--inicial {
    display: grid;
    place-items: center;
    background: var(--color-rule);
    color: var(--color-ink-soft);
    font-weight: 600;
    line-height: 1;
  }

  .depo__avatar {
    flex-shrink: 0;
    width: max(2rem, 0.751vw + 1.8239rem); /* 40px @1440 — escala fluida sem teto, ver CLAUDE.md */
    height: max(2rem, 0.751vw + 1.8239rem);
    border-radius: 50%;
    object-fit: cover;
  }

  /* Pedido do Felipe em 2026-09-08, mesmo raciocínio e mesma técnica do
     `@media (min-width: 90rem)` da economia circular (ver o comentário
     longo em `CircularEconomy.astro`): os tokens `--fs-*`/`--w-card` usados
     aqui crescem a uma taxa fixa (px por vw), mais devagar que `.depos__pino`
     — que não tem teto e acompanha a tela quase 1:1 — então em telas muito
     largas a proporção do design em 1440px se perde: os cartões (e o resto
     da faixa) ficam pequenos demais sobre um vão de página crescente demais.
     Cada valor abaixo é o mesmo do Figma em 1440px, só que expresso como
     fração de `.depos__pino` (`valor ÷ 1312 × 100`, a largura do container
     nesse instante) em vez de fração da viewport — daí em diante cresce com
     o espaço disponível da seção, não com a tela. Bate exatamente com os
     valores atuais em 1440px, por definição; abaixo de 90rem ninguém lê
     `cqi` nenhum, e os tokens padrão (com piso próprio, essenciais no
     celular) continuam mandando.

     Precisa vir DEPOIS de toda regra base acima que mira os mesmos
     seletores — `@media` não muda especificidade, só condição, e a regra
     que vier por último no arquivo vence a cascata quando as duas se
     aplicam (bug já visto uma vez na economia circular). */
  @media (min-width: 90rem) {
    .depos__label {
      font-size: 0.9146cqi; /* 12 ÷ 1312 × 100 */
    }

    .depos__title h2 {
      font-size: 3.2012cqi; /* 42 ÷ 1312 × 100 */
    }

    .depos__rating img {
      height: 1.9817cqi; /* 26 ÷ 1312 × 100 */
    }

    .depos__stars {
      height: 1.6768cqi; /* 22 ÷ 1312 × 100 */
    }

    .depos__cities {
      gap: 1.8293cqi; /* 24 ÷ 1312 × 100 */
    }

    .depos__cities .pill {
      font-size: 1.0671cqi; /* 14 ÷ 1312 × 100 */
    }

    .depo {
      /* Mesma proporção de `--w-card` (376px @1440), só que fração do
         container. `flex-basis`, não o `flex` inteiro: `0 0` já está
         definido na regra base e não muda. */
      flex-basis: 28.6585cqi; /* 376 ÷ 1312 × 100 */
    }

    .depo__quote {
      min-height: 17.6829cqi; /* 232 ÷ 1312 × 100 */
      font-size: 1.2195cqi; /* 16 ÷ 1312 × 100 */
    }

    .depo__by {
      font-size: 1.2195cqi; /* 16 ÷ 1312 × 100 */
    }

    .depo__avatar {
      width: 3.0488cqi; /* 40 ÷ 1312 × 100 */
      height: 3.0488cqi;
    }
  }
</style>

<script>
  /* Os cinco cartões nunca cabem na tela, e com a barra de rolagem escondida
     nada mais denunciava que havia depoimento à direita. Então a seção
     prende: enquanto o pino está grudado, o quanto a página andou dentro do
     trilho é exatamente o quanto a faixa anda para o lado, um pixel para cada
     pixel. Quem passou da seção leu todos os cartões no caminho.

     É posição, não evento: ninguém intercepta a roda, então não há disputa
     com a rolagem suave do Lenis, e roda, toque, teclado e barra de rolagem
     chegam todos ao mesmo lugar. Sem JS, a seção continua a faixa rolável
     que sempre foi. */

  /* Onde a trava não entra: no toque o dedo já arrasta a faixa direto, e
     prender a página tomaria dele um gesto que funciona; quem pediu menos
     movimento não tem por que ganhar a página andando de lado; e abaixo de
     48rem (mesmo corte de sempre, ver CLAUDE.md) a seção é estreita demais
     para valer o sequestro da rolagem — um mouse testando a versão mobile
     numa janela estreita não deve ganhar o pino que só faz sentido em
     desktop. */
  const ponteiroPreciso = matchMedia('(pointer: fine)');
  const menosMovimento = matchMedia('(prefers-reduced-motion: reduce)');
  const desktop = matchMedia('(min-width: 48rem)');

  document.querySelectorAll<HTMLElement>('[data-secao]').forEach((secao) => {
    const trilho = secao.querySelector<HTMLElement>('[data-trilho]');
    const pino = secao.querySelector<HTMLElement>('[data-pino]');
    const faixa = secao.querySelector<HTMLElement>('[data-carrossel]');
    if (!trilho || !pino || !faixa) return;

    let percurso = 0;
    let topo = 0;

    const medir = () => {
      /* Desfaz antes de medir: altura do trilho e `top` do pino são o que
         está sendo calculado, e medir por cima dos valores da vez anterior
         devolveria a resposta anterior. Como nada disso é pintado antes do
         fim da função, a desmontagem não pisca. */
      secao.classList.remove('is-preso');
      trilho.style.height = '';
      pino.style.removeProperty('--pino-topo');

      const excedente = faixa.scrollWidth - faixa.clientWidth;
      const alturaPino = pino.offsetHeight;

      if (excedente < 1 || !ponteiroPreciso.matches || menosMovimento.matches || !desktop.matches) {
        percurso = 0;
        /* Volta ao primeiro cartão: sem a trava, uma faixa parada no meio do
           percurso só pareceria cortada. */
        faixa.scrollLeft = 0;
        return;
      }

      /* Centrado quando sobra tela; encostado embaixo quando o pino é mais
         alto que ela, para o corte cair no título e não nos cartões. */
      const folga = window.innerHeight - alturaPino;
      topo = folga > 0 ? folga / 2 : folga;
      percurso = excedente;

      trilho.style.height = `${alturaPino + percurso}px`;
      pino.style.setProperty('--pino-topo', `${topo}px`);
      secao.classList.add('is-preso');
      acompanhar();
    };

    const acompanhar = () => {
      if (!percurso) return;
      /* Zero no instante em que o pino gruda, `percurso` no instante em que
         ele solta — o mesmo intervalo que a faixa tem para percorrer. */
      const andado = topo - trilho.getBoundingClientRect().top;
      faixa.scrollLeft = Math.min(Math.max(andado, 0), percurso);
    };

    /* A medição força layout; num `resize` contínuo isso é caro, e o quadro
       seguinte é cedo o bastante para ninguém perceber. */
    let agendada = 0;
    const remedir = () => {
      cancelAnimationFrame(agendada);
      agendada = requestAnimationFrame(medir);
    };

    /* Troca de cidade muda a largura da faixa, e nenhum observador de altura
       percebe isso: o script de pastilhas, mais abaixo, avisa por evento. */
    secao.addEventListener('depos:troca', () => {
      faixa.scrollLeft = 0;
      remedir();
    });

    window.addEventListener('scroll', acompanhar, { passive: true });
    /* `resize` pela altura da tela, que decide o `top`; ResizeObserver pela
       altura do pino, que muda com a fonte carregada e com a quebra do
       título — nenhum dos dois avisa pelo outro. */
    window.addEventListener('resize', remedir);
    new ResizeObserver(remedir).observe(pino);
    ponteiroPreciso.addEventListener('change', remedir);
    menosMovimento.addEventListener('change', remedir);
    desktop.addEventListener('change', remedir);

    medir();
  });

  /* Pastilhas de cidade: mostram só os cartões e o botão da cidade clicada. */
  document.querySelectorAll<HTMLElement>('[data-secao]').forEach((secao) => {
    const botoes = secao.querySelectorAll<HTMLButtonElement>('button[data-cidade]');

    botoes.forEach((botao) => {
      botao.addEventListener('click', () => {
        const cidade = botao.dataset.cidade;
        botoes.forEach((b) => {
          const ativo = b === botao;
          b.setAttribute('aria-pressed', String(ativo));
          b.classList.toggle('is-active', ativo);
        });
        secao.querySelectorAll<HTMLElement>('.depo').forEach((cartao) => {
          cartao.hidden = cartao.dataset.cidade !== cidade;
        });
        secao.querySelectorAll<HTMLElement>('[data-google]').forEach((g) => {
          g.hidden = g.dataset.google !== cidade;
        });
        secao.dispatchEvent(new Event('depos:troca'));
      });
    });
  });
</script>
