---
import { Image } from 'astro:assets';
import heroBg from '../assets/hero-bg.jpg';
import ppdLogo from '../assets/ppd-apple-logo-white.png';
import badge from '../assets/assinatura-h-white.png';
import { navLinks, instagramUrl, whatsappUrl } from '../data/site';

const social = [
  { label: 'Instagram', href: instagramUrl, icon: '/assets/icon-instagram.svg' },
  { label: 'WhatsApp', href: whatsappUrl, icon: '/assets/icon-whatsapp.svg' },
];
---

<section class="hero">
  <div class="hero__media" role="presentation">
    <Image
      src={heroBg}
      alt=""
      width={1440}
      height={777}
      widths={[480, 768, 1080, 1440, 1920]}
      sizes="100vw"
      format="webp"
      quality={70}
      class="hero__bg"
    />
    {/*
      Uma fonte por faixa de viewport: o navegador baixa só a que casa com
      o `media` (verificado no navegador — nenhuma requisição extra).
      `prefers-reduced-motion: no-preference` em todas faz com que, para
      quem pediu menos movimento, nenhuma fonte case: o vídeo não é
      baixado e a imagem acima permanece.
      Ordem do menor para o maior: se algum navegador ignorar `media`,
      ele cai no 720p — degradação barata, não quebrada.
      A quarta camada (2160p) só serve quem passa de 1440px de largura —
      a maioria do desktop já para na de 1440p; 2160p é para quem tem
      janela genuinamente larga (monitor grande, ultrawide), não todo
      mundo com tela Full HD.
    */}
    <video
      class="hero__video"
      autoplay
      muted
      loop
      playsinline
      aria-hidden="true"
    >
      <source
        src="/video/hero-720p.mp4"
        media="(prefers-reduced-motion: no-preference) and (max-width: 720px)"
        type="video/mp4"
      />
      <source
        src="/video/hero-1080p.mp4"
        media="(prefers-reduced-motion: no-preference) and (max-width: 1080px)"
        type="video/mp4"
      />
      <source
        src="/video/hero-1440p.mp4"
        media="(prefers-reduced-motion: no-preference) and (max-width: 1440px)"
        type="video/mp4"
      />
      <source
        src="/video/hero-2160p.mp4"
        media="(prefers-reduced-motion: no-preference)"
        type="video/mp4"
      />
    </video>
    <div class="hero__gradient"></div>
  </div>

  <div class="hero__inner">
    <nav class="hero__nav" aria-label="Navegação principal">
      {/* Duas assinaturas, uma por faixa: a horizontal de uma linha (180×30
          no Figma) é o topo do desktop; a de duas linhas continua sendo a do
          mobile, onde a largura ao lado do hambúrguer não comporta a outra.
          Só uma das duas está na árvore por vez — a outra sai com
          `display: none`, então nenhum leitor de tela ouve a marca duas
          vezes. */}
      <img
        src="/assets/logo-ppd-apple-white.svg"
        alt="Pede Pro Dindo — Revendedor autorizado Apple"
        width="180"
        height="30"
        class="hero__logo"
      />
      <Image
        src={badge}
        alt="Revendedor autorizado Apple"
        width={396}
        height={126}
        format="webp"
        quality={80}
        class="hero__badge-top"
      />

      <ul class="hero__links">
        {navLinks.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>

      <ul class="hero__social">
        {social.map((item) => (
          <li>
            <a href={item.href} aria-label={item.label}>
              <span class="icon" style={`--src: url(${item.icon})`}></span>
            </a>
          </li>
        ))}
      </ul>

      <button
        type="button"
        class="hero__burger"
        aria-expanded="false"
        aria-controls="menu-mobile"
        aria-label="Abrir menu"
        data-menu-open
      >
        <span></span><span></span><span></span>
      </button>
    </nav>

    {/* O texto que era o manifesto. Ele deixou de ser seção própria (Figma,
        2026-09-03) e desceu para o pé do hero, sobre a foto — por isso o
        `h1` da página mora aqui agora. */}
    <div class="hero__text">
      {/* As três linhas do nó `94:76`, lidas do render do Figma e travadas
          uma a uma. O nó não tem quebra manual: é uma caixa de 898px a 58px
          e o Poppins quebra sozinho dentro dela — mas quebra em lugares
          diferentes no Figma e no navegador, que compõe a mesma frase ~3%
          mais larga. Por isso as linhas vêm do render, não de reproduzir a
          caixa: aqui a caixa cede (ver o `max-content` no estilo) e as
          linhas mandam. Mexer no texto obriga a reexportar o frame e
          refazer os `<br>`. Abaixo de 48rem eles somem (`display: none`) e
          o texto volta a quebrar sozinho; o espaço antes de cada um é o que
          mantém a frase inteira quando isso acontece. */}
      <h1>A primeira <strong>Revenda Autorizada <br class="quebra" />da Apple</strong> no Brasil especializada <br class="quebra" />em <strong>economia circular.</strong></h1>
      {/* Nó `94:77`: caixa de 573px a 16px com altura fixa de 47px. Estas
          duas o navegador acerta na própria caixa do Figma — sobra 3px. */}
      <p><strong>Revisamos, avaliamos e garantimos.</strong> Cada detalhe do processo assegura <br class="quebra" />a entrega do melhor da tecnologia, com segurança e qualidade garantida.</p>
    </div>
  </div>
</section>

<div class="drawer" id="menu-mobile" hidden>
  <div class="drawer__top">
    <Image
      src={badge}
      alt="Revendedor autorizado Apple"
      width={396}
      height={126}
      format="webp"
      quality={80}
      class="drawer__badge"
    />
    <button
      type="button"
      class="drawer__close"
      aria-label="Fechar menu"
      data-menu-close
    >
      <img src="/assets/icon-close.svg" alt="" width="22" height="23" />
    </button>
  </div>

  <nav aria-label="Menu">
    <ul class="drawer__links">
      {navLinks.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
      <li class="drawer__social">
        {social.map((item) => (
          <a href={item.href} aria-label={item.label}>
            <span class="icon icon--lg" style={`--src: url(${item.icon})`}></span>
          </a>
        ))}
      </li>
    </ul>
  </nav>

  <div class="drawer__foot">
    <Image
      src={ppdLogo}
      alt="Pede Pro Dindo"
      width={900}
      height={632}
      format="webp"
      quality={80}
      class="drawer__brand"
    />
  </div>
</div>

<style>
  /* `min-height`, e não `height`: o hero deixou de ser só a moldura da marca
     e passou a carregar o texto que era o manifesto. Em tela baixa e estreita
     esse texto pede mais que uma tela, e altura fixa (com o `overflow`
     abaixo) o cortaria; assim o hero cresce e nada some. Em desktop a conta
     continua dando uma tela exata, como no Figma. */
  .hero {
    position: relative;
    z-index: 0;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100svh;
    color: var(--color-white);
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Reforço ao `media` das fontes: garante que o movimento suma mesmo se
     algum navegador ignorar o atributo e carregar o vídeo assim mesmo. */
  @media (prefers-reduced-motion: reduce) {
    .hero__video {
      display: none;
    }
  }

  .hero__gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.83) 0%,
      rgba(0, 0, 0, 0.33) 50%,
      rgba(0, 0, 0, 0.83) 100%
    );
  }

  /* Sem `max-width`/`margin-inline: auto`: até 2026-09-08 esta coluna travava
     em `--page-max` (1920px) e virava uma faixa centralizada em telas
     ultrawide, com o nav e o headline se afastando da borda esquerda em vez
     de acompanhá-la — pedido do Felipe foi "obedecer o resto do site", que
     não tem teto de página nenhum (Stores, Testimonials, Faq, Footer são só
     `padding: var(--space-lg) var(--space-md)`, sem `max-width`). O respiro
     lateral aqui é o mesmo `--space-md` fluido de sempre, e cada elemento de
     texto segue com o próprio teto local (`max-width: 100%` no `h1`/`p`, o
     `min(..., 6.2cqi)` abaixo). */
  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    flex: 1;
    width: 100%;
    padding: var(--space-hero-top) var(--space-md) var(--space-md);
    gap: var(--space-sm);
  }

  .hero__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .hero__logo {
    width: max(7.5rem, 5.634vw + 6.1795rem); /* 180px @1440 — escala fluida sem teto, ver CLAUDE.md */
    height: auto;
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: max(1rem, 1.878vw + .5599rem); /* 36px @1440 — escala fluida sem teto, ver CLAUDE.md */
  }

  .hero__links a {
    font-size: var(--fs-nav);
    line-height: 1.3;
    color: var(--color-nav);
  }

  .hero__social {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    color: var(--color-text-soft);
  }

  /* Máscara em vez de `<img>`: o mesmo arquivo serve o hero (cinza) e o
     menu mobile (claro) só herdando a cor do contexto. */
  .icon {
    display: block;
    width: max(1rem, 0.282vw + .934rem); /* 19px @1440 — escala fluida sem teto, ver CLAUDE.md */
    aspect-ratio: 1;
    background-color: currentColor;
    -webkit-mask: var(--src) no-repeat center / contain;
    mask: var(--src) no-repeat center / contain;
  }

  .hero__burger {
    display: none;
    flex-direction: column;
    gap: 4px;
    width: 29px;
    padding: 6px 0;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .hero__burger span {
    height: 2px;
    background: var(--color-white);
  }

  .hero__badge-top {
    display: none;
    width: clamp(5.5rem, 23.7vw, 8rem); /* 110px @464 */
    height: auto;
  }

  /* `margin-top: auto` empurra o bloco para o pé do hero: no Figma o
     parágrafo termina a 55px da borda de baixo, e o respiro daqui é o
     `--space-md` do próprio invólucro. */
  .hero__text {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-list);
    /* Container de consulta: é a largura daqui que o teto do `h1` lê em
       `cqi`, mais abaixo. */
    container-type: inline-size;
  }

  /* Onde o texto quebra já está decidido no HTML, então a caixa não escolhe
     mais nada — ela só não pode ser mais estreita que a maior linha, ou o
     navegador quebraria de novo por cima das quebras travadas.
     `width: max-content` cola a caixa na maior linha. Ela não bate a caixa
     do Figma: a mesma frase sai ~3% mais larga aqui (928px contra 898px no
     `h1`), porque peso e espaçamento do Poppins não são idênticos nos dois
     renderizadores. Como o texto é alinhado à esquerda, o que se vê são as
     mesmas linhas começando no mesmo x — a diferença fica na borda direita,
     que é ar. Foi a troca escolhida: mesmas quebras e mesmo corpo, caixa
     um pouco maior.
     (Largura em `em` não resolveria: o avanço dos glifos não escala
     exatamente com o corpo, e a 768px a primeira linha do `h1` ganhava uma
     palavra que a 1440px não cabia.)
     `max-width: 100%` é a rede: se ainda assim faltar espaço, o texto
     quebra em vez de vazar a página. */
  .hero__text h1 {
    width: max-content;
    max-width: 100%;
    font-size: var(--fs-h1);
    line-height: 1.3;
    font-weight: 400;
  }

  .hero__text p {
    width: max-content;
    max-width: 100%;
    font-size: var(--fs-card);
    line-height: 1.5;
  }

  /* Teto de corpo para o `h1`, e só para ele: garante que a maior linha
     (15.995em, "da Apple no Brasil especializada") caiba na coluna sempre,
     custe o que custar em corpo — porque não caber significa o navegador
     quebrar por cima das quebras do Figma. 100 ÷ 15.995 = 6.25; 6.2 deixa
     0,8% de margem para o avanço dos glifos não escalar exatamente com o
     corpo.
     Hoje só morde perto de ~770px, onde a coluna é de 690px e a linha pede
     685px (a 0,1% de corpo, invisível) — no resto da faixa quem vence o
     `min()` é `--fs-h1`, então o corpo é o da escala fluida do CLAUDE.md,
     igual ao Figma em 1440px. Até 2026-09-08 também mordia acima de
     ~3390px, quando `--page-max` travava `.hero__inner` em 1920px e o
     respiro lateral passava a comer a coluna; esse teto saiu (ver comentário
     em `.hero__inner`) e o `min()` nunca mais precisa escolher o lado
     `6.2cqi` lá em cima — fica inofensivo, não removido, porque a mordida de
     baixo continua real.
     Fora do `@media` isto estragaria o mobile, onde a coluna é estreita e o
     teto puxaria a headline para uns 21px. */
  @media (min-width: 48rem) {
    .hero__text h1 {
      font-size: min(var(--fs-h1), 6.2cqi);
    }
  }

  .hero__text strong {
    font-weight: 600;
  }

  /* Mudança de comportamento: os links + ícones deixam de caber numa linha,
     então o menu vira gaveta e a assinatura troca pela de duas linhas. */
  @media (max-width: 47.99rem) {
    /* Fora do desktop as quebras do Figma saem de cena: a composição de
       1440px não cabe numa coluna de celular, e o frame mobile do hero nem
       foi redesenhado ainda (ver pendências). */
    .quebra {
      display: none;
    }

    .hero__links,
    .hero__social,
    .hero__logo {
      display: none;
    }

    .hero__burger {
      display: flex;
    }

    .hero__badge-top {
      display: block;
    }
  }

  .drawer {
    position: fixed;
    inset: 0;
    z-index: 10;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-md);
    background: var(--color-black);
    color: var(--color-nav);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .drawer[hidden] {
    display: none;
  }

  .drawer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .drawer__badge {
    width: clamp(5.5rem, 23.7vw, 8rem); /* 110px @464 */
    height: auto;
  }

  .drawer__close {
    padding: 6px;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .drawer__links {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .drawer__links li {
    padding-bottom: 18px;
    border-bottom: 1px solid var(--color-nav-rule);
  }

  .drawer__links a {
    font-size: var(--fs-nav-drawer);
    line-height: 1.3;
  }

  .drawer__social {
    display: flex;
    gap: 18px;
  }

  .icon--lg {
    width: 22px;
  }

  .drawer__brand {
    width: clamp(6rem, 26.3vw, 9rem); /* 122px @464 */
    height: auto;
  }
</style>

<script>
  /* JS porque uma gaveta em tela cheia precisa de estado compartilhado
     entre botão e painel (`aria-expanded`), fechar no Esc e devolver o
     foco — nada disso o CSS alcança sozinho. */
  const drawer = document.getElementById('menu-mobile');
  const abrir = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const fechar = document.querySelector<HTMLButtonElement>('[data-menu-close]');

  if (drawer && abrir && fechar) {
    const desktop = matchMedia('(min-width: 48rem)');

    const set = (aberto: boolean) => {
      drawer.hidden = !aberto;
      abrir.setAttribute('aria-expanded', String(aberto));
      /* Sem isto a página continua rolando atrás da gaveta. */
      document.body.style.overflow = aberto ? 'hidden' : '';
      (aberto ? fechar : abrir).focus();
    };

    abrir.addEventListener('click', () => set(true));
    fechar.addEventListener('click', () => set(false));

    /* Navegar para uma âncora da própria página não recarrega nada, então
       a gaveta ficaria aberta por cima do destino. */
    drawer.querySelectorAll('a').forEach((link) =>
      link.addEventListener('click', () => set(false))
    );

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !drawer.hidden) set(false);
    });

    /* Girar o aparelho para paisagem passa do breakpoint e o menu de
       desktop reaparece — a gaveta não pode continuar por cima. */
    desktop.addEventListener('change', () => {
      if (desktop.matches && !drawer.hidden) set(false);
    });
  }

  /* Hero sem parallax, de propósito. Ele já teve um (subia a 30% da rolagem);
     o efeito passou para a camada do manifesto quando a abertura entrou, e com
     o manifesto fora do site (2026-09-03) o hero voltou a ser uma seção comum,
     que rola 1:1 como qualquer outra. `Abertura.astro` segue no repositório
     como implementação de referência do efeito, sem página que a importe. */
</script>
