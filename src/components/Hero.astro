---
import { Image } from 'astro:assets';
import heroBg from '../assets/hero-bg.png';
import ppdLogo from '../assets/ppd-apple-logo-white.png';
import badge from '../assets/assinatura-h-white.png';

const navLinks = [
  { label: 'Sobre', href: '#' },
  { label: 'Unidades', href: '#' },
  { label: 'Produtos', href: '#' },
  { label: 'Trabalhe conosco', href: '#' },
];
---

<section class="hero">
  <div class="hero__media" role="presentation">
    <Image
      src={heroBg}
      alt=""
      width={1440}
      height={777}
      widths={[480, 768, 1080, 1440, 1920]}
      sizes="100vw"
      format="webp"
      quality={70}
      class="hero__bg"
    />
    <div class="hero__gradient"></div>
  </div>

  <div class="hero__inner">
    <nav class="hero__nav" aria-label="Navegação principal">
      <ul class="hero__links">
        {navLinks.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
      <ul class="hero__social">
        <li>
          <a href="#" aria-label="Instagram">
            <img src="/assets/icon-instagram.svg" alt="" width="19" height="19" />
          </a>
        </li>
        <li>
          <a href="#" aria-label="WhatsApp">
            <img src="/assets/icon-whatsapp.svg" alt="" width="19" height="19" />
          </a>
        </li>
      </ul>
    </nav>

    <div class="hero__footer">
      <Image
        src={ppdLogo}
        alt="Pede Pro Dindo"
        width={900}
        height={632}
        format="webp"
        quality={80}
        class="hero__brand"
      />
      <Image
        src={badge}
        alt="Revendedor autorizado Apple"
        width={396}
        height={126}
        format="webp"
        quality={80}
        class="hero__badge"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: clamp(35rem, 54vw, 48.5625rem);
    color: var(--color-white);
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.83) 0%,
      rgba(0, 0, 0, 0.63) 50%,
      rgba(0, 0, 0, 0.83) 100%
    );
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    flex: 1;
    width: 100%;
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--space-hero-top) var(--space-md) var(--space-md);
    gap: var(--space-sm);
  }

  .hero__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .hero__links a {
    font-size: var(--fs-nav);
    font-weight: 500;
    line-height: 1.5;
  }

  .hero__social {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .hero__social img {
    width: 1.1875rem;
    height: 1.1875rem;
  }

  .hero__footer {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .hero__brand {
    width: clamp(12.5rem, 31.25vw, 28.125rem);
    height: auto;
  }

  .hero__badge {
    width: clamp(8rem, 13.75vw, 12.375rem);
    height: auto;
  }
</style>
