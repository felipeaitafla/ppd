---
import { Image } from 'astro:assets';
import heroBg from '../assets/hero-bg.jpg';
import { instagramUrl, whatsappUrl } from '../data/site';

/* Instagram abre em nova aba (pedido do Felipe, 2026-09-30) — tira a pessoa
   do site para outra plataforma. WhatsApp não: `wa.me` já entrega ao app. */
const social = [
  { label: 'Instagram', href: instagramUrl, icon: '/assets/icon-instagram.svg', newTab: true },
  { label: 'WhatsApp', href: whatsappUrl, icon: '/assets/icon-whatsapp.svg' },
];
---

<section class="hero">
  <div class="hero__media" role="presentation">
    <Image
      src={heroBg}
      alt=""
      width={1440}
      height={777}
      widths={[480, 768, 1080, 1440, 1920]}
      sizes="100vw"
      format="webp"
      quality={70}
      class="hero__bg"
    />
    {/*
      Uma fonte por faixa de viewport: o navegador baixa só a que casa com
      o `media` (verificado no navegador — nenhuma requisição extra).
      `prefers-reduced-motion: no-preference` em todas faz com que, para
      quem pediu menos movimento, nenhuma fonte case: o vídeo não é
      baixado e a imagem acima permanece.
      Ordem do menor para o maior: se algum navegador ignorar `media`,
      ele cai no 720p — degradação barata, não quebrada.
      A quarta camada (2160p) só serve quem passa de 1440px de largura —
      a maioria do desktop já para na de 1440p; 2160p é para quem tem
      janela genuinamente larga (monitor grande, ultrawide), não todo
      mundo com tela Full HD.
    */}
    <video
      class="hero__video"
      autoplay
      muted
      loop
      playsinline
      aria-hidden="true"
    >
      <source
        src="/video/hero-720p.mp4"
        media="(prefers-reduced-motion: no-preference) and (max-width: 720px)"
        type="video/mp4"
      />
      <source
        src="/video/hero-1080p.mp4"
        media="(prefers-reduced-motion: no-preference) and (max-width: 1080px)"
        type="video/mp4"
      />
      <source
        src="/video/hero-1440p.mp4"
        media="(prefers-reduced-motion: no-preference) and (max-width: 1440px)"
        type="video/mp4"
      />
      <source
        src="/video/hero-2160p.mp4"
        media="(prefers-reduced-motion: no-preference)"
        type="video/mp4"
      />
    </video>
    <div class="hero__gradient"></div>
  </div>

  <div class="hero__inner">
    {/* Só marca e ícones, em qualquer faixa (pedido do Felipe, 2026-09-30):
        os quatro links de seção saíram do topo, e com eles o menu mobile
        (☰ + gaveta), que só repetia esses links e os mesmos dois ícones —
        agora visíveis direto aqui. A navegação por seção continua no
        rodapé (`navLinks`, em `Footer.astro`). `header` e não `nav`: sem
        links de seção, o que sobra não é navegação do site. */}
    <header class="hero__nav">
      {/* Uma assinatura só, em qualquer faixa: até 2026-09-16 o mobile usava
          um PNG à parte (`assinatura-h-white.png`) que, apesar do nome,
          continha só o selo da Apple — sem a marca "pede pro dindo". O SVG
          abaixo é o mesmo lockup completo do desktop (626×237.3 no Figma). */}
      <img
        src="/assets/logo-ppd-apple-white.svg"
        alt="Pede Pro Dindo — Revendedor autorizado Apple"
        width="626"
        height="237"
        class="hero__logo"
      />

      <ul class="hero__social">
        {social.map((item) => (
          <li>
            <a
              href={item.href}
              aria-label={item.newTab ? `${item.label} (abre em nova aba)` : item.label}
              target={item.newTab ? '_blank' : undefined}
              rel={item.newTab ? 'noopener noreferrer' : undefined}
            >
              <span class="icon" style={`--src: url(${item.icon})`}></span>
            </a>
          </li>
        ))}
      </ul>

    </header>

    {/* O texto que era o manifesto. Ele deixou de ser seção própria (Figma,
        2026-09-03) e desceu para o pé do hero, sobre a foto — por isso o
        `h1` da página mora aqui agora. */}
    <div class="hero__text">
      {/* As três linhas do nó `94:76` (desktop, `.quebra`) e as quatro do nó
          `126:157` (mobile, `.quebra-mobile`), lidas do render do Figma e
          travadas uma a uma — mesma técnica dos dois, cada um lendo o frame
          da própria faixa. Nenhum dos dois nós tem quebra manual: o Poppins
          quebra sozinho dentro da caixa do Figma, em lugares que o navegador
          não repete (compõe a mesma frase mais larga). Por isso as linhas
          vêm do render, não de reproduzir a caixa: a caixa cede (`max-content`
          no estilo) e as linhas mandam. Mexer no texto obriga a reexportar os
          DOIS frames e refazer os `<br>` das duas faixas. Um ponto de quebra
          — antes de "em" — cai no mesmo lugar nas duas composições, por isso
          é um `<br>` sem classe, sempre visível; os outros três (mobile) e
          dois (desktop) são exclusivos da própria faixa, trocados por
          `display: none` abaixo de/a partir de 48rem. O espaço antes de cada
          `<br>` não é enfeite: é o que mantém a frase inteira quando a
          classe do outro lado o esconde. */}
      <h1>A primeira <strong>Revenda <br class="quebra-mobile" />Autorizada <br class="quebra" />da Apple</strong> <br class="quebra-mobile" />no Brasil especializada <br />em <strong>economia circular.</strong></h1>
      <p><strong>Revisamos, avaliamos e garantimos.</strong> Cada detalhe do processo assegura a entrega do melhor da tecnologia, com segurança e qualidade garantida.</p>
    </div>
  </div>
</section>

<style>
  /* `min-height`, e não `height`: o hero deixou de ser só a moldura da marca
     e passou a carregar o texto que era o manifesto. Em tela baixa e estreita
     esse texto pede mais que uma tela, e altura fixa (com o `overflow`
     abaixo) o cortaria; assim o hero cresce e nada some. Em desktop a conta
     continua dando uma tela exata, como no Figma. */
  .hero {
    position: relative;
    z-index: 0;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100svh;
    color: var(--color-white);
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Reforço ao `media` das fontes: garante que o movimento suma mesmo se
     algum navegador ignorar o atributo e carregar o vídeo assim mesmo. */
  @media (prefers-reduced-motion: reduce) {
    .hero__video {
      display: none;
    }
  }

  .hero__gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.83) 0%,
      rgba(0, 0, 0, 0.33) 50%,
      rgba(0, 0, 0, 0.83) 100%
    );
  }

  /* Sem `max-width`/`margin-inline: auto`: até 2026-09-08 esta coluna travava
     em `--page-max` (1920px) e virava uma faixa centralizada em telas
     ultrawide, com o nav e o headline se afastando da borda esquerda em vez
     de acompanhá-la — pedido do Felipe foi "obedecer o resto do site", que
     não tem teto de página nenhum (Stores, Testimonials, Faq, Footer são só
     `padding: var(--space-lg) var(--space-md)`, sem `max-width`). O respiro
     lateral aqui é o mesmo `--space-md` fluido de sempre, e cada elemento de
     texto segue com o próprio teto local (`max-width: 100%` no `h1`/`p`, o
     `min(..., 6.2cqi)` abaixo). */
  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    flex: 1;
    width: 100%;
    padding: var(--space-hero-top) var(--space-md) var(--space-md);
    gap: var(--space-sm);
  }

  .hero__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .hero__logo {
    width: max(7.5rem, 5.634vw + 6.1795rem); /* mesmo slot de sempre (180px @1440), escala fluida sem teto, ver CLAUDE.md — só a arte trocou, o SVG v2 é mais alto (626×237.3) que o antigo (180×30) */
    height: auto;
  }

  .hero__social {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    color: var(--color-text-soft);
  }

  /* Máscara em vez de `<img>`: a cor vem do contexto (`currentColor`).
     24px @1440, piso 20px — era 19px/16px até 2026-09-30, quando os links
     saíram do topo e os ícones ficaram sozinhos ao lado da marca. */
  .icon {
    display: block;
    width: max(1.25rem, 0.376vw + 1.162rem); /* 24px @1440 — escala fluida sem teto, ver CLAUDE.md */
    aspect-ratio: 1;
    background-color: currentColor;
    -webkit-mask: var(--src) no-repeat center / contain;
    mask: var(--src) no-repeat center / contain;
  }

  /* `margin-top: auto` empurra o bloco para o pé do hero: no Figma o
     parágrafo termina a 55px da borda de baixo, e o respiro daqui é o
     `--space-md` do próprio invólucro. */
  .hero__text {
    margin-top: auto;
    /* Grade de uma trilha que cola na maior linha do `h1` (`max-content`) e
       cede se a coluna for menor (`minmax(0, …)`). O parágrafo entra com
       `width: 0; min-width: 100%`: não conta para o tamanho da trilha e
       depois estica até ela — ver `.hero__text p`. */
    display: grid;
    grid-template-columns: minmax(0, max-content);
    justify-content: start;
    gap: var(--space-list);
    /* Container de consulta: é a largura daqui que o teto do `h1` lê em
       `cqi`, mais abaixo. */
    container-type: inline-size;
  }

  /* Onde o texto quebra já está decidido no HTML, então a caixa não escolhe
     mais nada — ela só não pode ser mais estreita que a maior linha, ou o
     navegador quebraria de novo por cima das quebras travadas.
     `width: max-content` cola a caixa na maior linha. Ela não bate a caixa
     do Figma: a mesma frase sai ~3% mais larga aqui (928px contra 898px no
     `h1`), porque peso e espaçamento do Poppins não são idênticos nos dois
     renderizadores. Como o texto é alinhado à esquerda, o que se vê são as
     mesmas linhas começando no mesmo x — a diferença fica na borda direita,
     que é ar. Foi a troca escolhida: mesmas quebras e mesmo corpo, caixa
     um pouco maior.
     (Largura em `em` não resolveria: o avanço dos glifos não escala
     exatamente com o corpo, e a 768px a primeira linha do `h1` ganhava uma
     palavra que a 1440px não cabia.)
     `max-width: 100%` é a rede: se ainda assim faltar espaço, o texto
     quebra em vez de vazar a página. */
  .hero__text h1 {
    width: max-content;
    max-width: 100%;
    font-size: var(--fs-h1);
    line-height: 1.3;
    font-weight: 400;
  }

  /* O subtexto do hero NÃO usa `--fs-card`: aquele token é corpo de texto
     corrido e escala de leve (piso 15px muito perto dos 16px de 1440), então
     ao lado do `h1` — que dispara com a viewport — ele parecia estacionado
     em telas largas. Aqui o lead acompanha o título: escala proporcional ao
     frame de 1440 (16px = 1.111vw), a proporção do Figma mantida em qualquer
     largura de desktop, sem teto. Piso de 15px (`.9375rem`) para telas
     estreitas — abaixo de 48rem o hero já troca para o layout mobile de
     qualquer forma.

     `width: 0; min-width: 100%`: pedido do Felipe em 2026-09-17 foi prender
     a quebra do parágrafo (que não tem `<br>` travado nenhum) no limite
     direito do título, e não no da coluna inteira. Um parágrafo normal
     contribui com a LARGURA DO TEXTO INTEIRO NUMA LINHA SÓ para o
     `max-content` do pai e esticaria a trilha além do `h1`. Com `width: 0`
     ele contribui com zero; `min-width: 100%` (cíclico no cálculo da
     trilha, resolvido depois) o estica até a largura que o `h1` definiu.
     CSS puro, certo no primeiro quadro: antes, um script medindo o `h1`
     (e remedindo quando a fonte chegava) fazia o lead reflowar 1–2s após a
     carga. */
  .hero__text p {
    width: 0;
    min-width: 100%;
    font-size: max(.9375rem, 1.111vw); /* 16px @1440 — proporcional, ver comentário acima */
    line-height: 1.5;
  }

  /* Teto de corpo para o `h1`, e só para ele: garante que a maior linha
     (15.995em, "da Apple no Brasil especializada") caiba na coluna sempre,
     custe o que custar em corpo — porque não caber significa o navegador
     quebrar por cima das quebras do Figma. 100 ÷ 15.995 = 6.25; 6.2 deixa
     0,8% de margem para o avanço dos glifos não escalar exatamente com o
     corpo.
     Hoje só morde perto de ~770px, onde a coluna é de 690px e a linha pede
     685px (a 0,1% de corpo, invisível) — no resto da faixa quem vence o
     `min()` é `--fs-h1`, então o corpo é o da escala fluida do CLAUDE.md,
     igual ao Figma em 1440px. Até 2026-09-08 também mordia acima de
     ~3390px, quando `--page-max` travava `.hero__inner` em 1920px e o
     respiro lateral passava a comer a coluna; esse teto saiu (ver comentário
     em `.hero__inner`) e o `min()` nunca mais precisa escolher o lado
     `6.2cqi` lá em cima — fica inofensivo, não removido, porque a mordida de
     baixo continua real.
     Fora do `@media` isto estragaria o mobile, onde a coluna é estreita e o
     teto puxaria a headline para uns 21px. */
  @media (min-width: 48rem) {
    .hero__text h1 {
      font-size: min(var(--fs-h1), 6.2cqi);
    }
  }

  .hero__text strong {
    font-weight: 600;
  }

  /* Escondida por padrão (desktop): só existe para reaparecer dentro do
     `@media` abaixo, trocando de lugar com `.quebra` — ver o comentário
     junto do `h1`/`p` acima. */
  .quebra-mobile {
    display: none;
  }

  /* Teto de corpo do `h1` NO MOBILE — mesma ideia do teto de desktop acima
     (`6.2cqi`), mas com a razão da maior linha MOBILE: "em economia
     circular." mede 11.521em (medido no navegador, Poppins/negrito
     incluídos — não é o valor do Figma). Ao piso de `--fs-h1` (32px = o
     valor do Figma em 375px), essa linha pede ~368px onde a coluna tem
     327px: sem este teto ela quebra em duas ("em economia" / "circular."),
     por cima da quebra travada. 100 ÷ 11.521 = 8.679; 8.6 deixa ~0,9% de
     margem, mesmo espírito do teto de desktop. Ao contrário daquele (que só
     morde perto do limite superior da faixa), este morde a faixa TODA — o
     piso do Figma nunca chega a caber sozinho abaixo de 48rem. */
  @media (max-width: 47.99rem) {
    .hero__text h1 {
      font-size: min(var(--fs-h1), 8.6cqi);
    }
  }

  /* As quebras do desktop saem de cena e as do mobile (nó `126:157`/
     `126:158` do Figma) tomam o lugar — ver o comentário junto do `h1`/`p`.
     O topo (marca + ícones) não muda de faixa: sem links, ele cabe numa
     linha em qualquer largura. */
  @media (max-width: 47.99rem) {
    .quebra {
      display: none;
    }

    .quebra-mobile {
      display: initial;
    }
  }
</style>
