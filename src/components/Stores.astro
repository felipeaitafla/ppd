---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import { units } from '../data/site';
import colagem1 from '../assets/loja-colagem-1.png';
import colagem2 from '../assets/loja-colagem-2.png';
import colagem3 from '../assets/loja-colagem-3.png';
import colagem4 from '../assets/loja-colagem-4.png';
import colagem5 from '../assets/loja-colagem-5.png';
import colagem6 from '../assets/loja-colagem-6.png';
import colagem7 from '../assets/loja-colagem-7.png';

/* Colagem das lojas (2026-10-26), no lugar da galeria rotativa por unidade.
   Veio de um export do Framer: sete recortes PNG com transparência — a forma
   (pílula, arco) já está no arquivo, não no CSS — soltos numa caixa de
   524×520. Cada `x`/`y`/`w` abaixo é a medida do original naquela caixa, e
   o CSS as converte em porcentagem: a colagem inteira escala com a coluna,
   sem altura fixa. A ordem é a do original e é também a ordem de empilhar:
   o arco grande (`centro`) fica acima dos dois primeiros e abaixo dos
   quatro seguintes. O arco é o único posicionado pelo centro. */
const CAIXA = { w: 524, h: 520 };
const pecas = [
  { src: colagem1, x: 54, y: 119, w: 109, alt: 'Fachada de uma unidade, com o letreiro azul "Pede Pro Dindo"' },
  { src: colagem2, x: 389, y: 193, w: 122, alt: 'Fachada de uma unidade, com o letreiro azul "Pede Pro Dindo"' },
  { src: colagem3, centro: [0.52, 0.49], w: 278, alt: 'Interior da loja, com árvore decorativa, mesa de madeira e o logo "ppd" na parede azul' },
  { src: colagem4, x: 342, y: 109, w: 182, alt: 'Parede da loja com capas e acessórios em exposição' },
  { src: colagem5, x: 67, y: 354, w: 110, alt: 'Fachada de uma unidade, com o letreiro azul "Pede Pro Dindo"' },
  { src: colagem6, x: 0, y: 292, w: 206, alt: 'Mesa de madeira com iPhones em exposição' },
  { src: colagem7, x: 316, y: 346, w: 175, alt: 'iPhones em exposição sobre a bancada, presos nos suportes' },
];
const pct = (valor: number, total: number) => `${((valor / total) * 100).toFixed(4)}%`;
---

{/* O `id` voltou para cá em 2026-09-04, quando a revelação saiu da passagem
    da economia circular para esta seção: sem camada nenhuma andando, a seção
    está sempre onde o fluxo a coloca, e o alvo do menu pode ser ela mesma. */}
<section class="stores" id="unidades">
  {/* Decorativa: cada recorte tem o próprio `alt`, mas a colagem inteira é
      uma imagem só para quem lê — as lojas em si estão descritas na lista. */}
  <div class="stores__collage" role="group" aria-label="Fotos das lojas">
    {pecas.map((peca) => (
      <Image
        src={peca.src}
        alt={peca.alt}
        width={Math.round(peca.w * 3)}
        format="webp"
        quality={80}
        loading="lazy"
        decoding="async"
        class="stores__piece"
        style={
          peca.centro
            ? `left:${peca.centro[0] * 100}%;top:${peca.centro[1] * 100}%;width:${pct(peca.w, CAIXA.w)};transform:translate(-50%,-50%)`
            : `left:${pct(peca.x, CAIXA.w)};top:${pct(peca.y, CAIXA.h)};width:${pct(peca.w, CAIXA.w)}`
        }
      />
    ))}
    <p class="stores__badge">Até 200m² de conforto<br />e segurança.</p>
  </div>

  <div class="stores__content">
    <div class="stores__head">
      <span class="stores__label">Onde nos encontrar</span>
      <h2 class="stores__headline">Visite a PPD mais próxima.</h2>
    </div>

    <ul class="stores__list">
      {units.map((unit) => (
        <li>
          {/* `details name` dá acordeão exclusivo sem uma linha de JS. */}
          <details class="stores__unit" name="unidades" open={unit.matriz}>
            <summary class="stores__unit-head">
              {/* `h3` para o nome da unidade ser título (h2 "Visite a PPD
                  mais próxima" → h3 por cidade) para quem lê a estrutura;
                  herda fonte e margem zero de `global.css`. */}
              <h3>{unit.label}</h3>
              <span class="stores__unit-mark" aria-hidden="true"></span>
            </summary>
            {/* `-body` recolhe (max-height, sem padding próprio); `-inner`
                carrega o padding. Padding não encolhe abaixo do próprio
                valor mesmo com `max-height: 0` no elemento que o tem — por
                isso ele mora num filho, não na caixa que anima. */}
            <div class="stores__unit-body">
              <div class="stores__unit-body-inner">
                <Button href={unit.mapsUrl}>{unit.address}</Button>
                <Button href={unit.instagramUrl} newTab>{unit.instagram}</Button>
              </div>
            </div>
          </details>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .stores {
    display: grid;
    align-items: center;
    gap: var(--space-md);
    /* Respiro vertical dobrado (128px) contra os 64px das laterais. O mesmo
       par vale em Depoimentos e no FAQ: as três seções de conteúdo longo
       ficam com a mesma moldura, e a diferença entre elas passa a ser o
       fundo, não o espaçamento. O respiro de cima também é o que separa a
       primeira foto do texto da economia circular, que agora encosta nesta
       seção sem efeito nenhum no meio. */
    padding: var(--space-lg) var(--space-md);
    /* Declarado, e não herdado do corpo da página: é o mesmo branco, mas
       esta seção não pode depender de quem está atrás dela para ter fundo. */
    background: var(--color-white);
  }

  /* Mudança de comportamento: abaixo disso a galeria fica estreita demais
     para as três fotos da faixa lerem como fotos. */
  @media (min-width: 60rem) {
    .stores {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* A caixa tem a proporção do original (524×520); as peças dentro são
     porcentagem dela, então tudo cresce junto com a coluna. Abaixo de 60rem
     a coluna é a página inteira, e a colagem pararia de fazer sentido de tão
     larga: o teto de 36rem centraliza e segura. */
  .stores__collage {
    position: relative;
    width: 100%;
    max-width: 36rem;
    margin-inline: auto;
    aspect-ratio: 524 / 520;
    container-type: inline-size;
  }

  @media (min-width: 60rem) {
    .stores__collage {
      max-width: none;
    }
  }

  .stores__piece {
    position: absolute;
    height: auto;
  }

  /* Vidro fosco no canto superior esquerdo do arco grande, com o canto
     inferior esquerdo reto, como no original. A posição é a do original em
     porcentagem da caixa: 103px/524 e 84px/520. */
  .stores__badge {
    position: absolute;
    z-index: 1;
    left: 19.6565%;
    top: 16.1538%;
    /* Largura do texto, não da caixa do original: com a quebra manual
       depois de "conforto", o vidro cola na linha mais longa e o respiro é
       igual dos dois lados. */
    width: max-content;
    padding: 1em 1.25em;
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 1rem 1rem 1rem 0;
    /* Cinza translúcido, e não o branco 60% do original: a ponta esquerda
       do vidro cai sobre o fundo branco da página, onde o texto branco
       sumiria. Sobre branco dá ~#C5C5C5, o tom do print. */
    background: rgb(150 150 150 / 0.55);
    backdrop-filter: blur(26px);
    /* 14px na caixa de 524px do original: o texto acompanha a colagem e
       quebra em duas linhas como lá, em qualquer largura. */
    font-size: 2.6718cqi;
    line-height: 1.3;
    color: var(--color-white);
  }

  .stores__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .stores__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .stores__label {
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-label);
  }

  .stores__headline {
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: 1.1;
  }

  .stores__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-list);
  }

  /* Mais respiro só no mobile (abaixo de 48rem, corte de sempre): empilhado
     em coluna única, rótulo, título e as linhas do acordeão ficavam
     espremidos uns nos outros; o desktop já tem folga própria ao lado da
     galeria e os tokens base bastam. */
  @media (max-width: 47.99rem) {
    .stores__content {
      gap: var(--space-xl);
    }

    .stores__head {
      gap: var(--space-md);
    }

    .stores__list {
      gap: var(--space-block);
    }
  }

  /* A régua é do próprio cabeçalho, não da lista: assim ela aparece igual na
     unidade aberta e na fechada, sem depender de qual é a última. */
  .stores__unit-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-bottom: var(--space-rule);
    border-bottom: 1px solid var(--color-rule-faint);
    font-size: var(--fs-unit);
    font-weight: 500;
    line-height: 1.5;
    cursor: pointer;
    list-style: none;
  }

  .stores__unit-head::-webkit-details-marker {
    display: none;
  }

  .stores__unit-head:focus-visible {
    outline: 2px solid var(--color-black);
    outline-offset: 4px;
  }

  .stores__unit-mark {
    flex-shrink: 0;
    width: max(.875rem, 0.376vw + .787rem); /* 18px @1440 — escala fluida sem teto, ver CLAUDE.md */
    font-weight: 400;
    text-align: right;
  }

  .stores__unit-mark::before {
    content: '+';
  }

  .stores__unit[open] .stores__unit-mark::before {
    content: '−';
  }

  /* Padding mora aqui, não em `.stores__unit-body` (que é quem anima) —
     nenhuma caixa encolhe abaixo do próprio padding, `max-height: 0` e tudo:
     um `<div>` com `padding-top: 24px` sempre mede pelo menos 24px, porque
     padding não é conteúdo que possa "acabar", é espaço fixo que a caixa
     sempre reserva. Se o padding estivesse na caixa que recolhe, ela travaria
     perto de 30px (padding-top + padding-bottom) até `content-visibility`
     cortar de vez no fim da transição — daí o soluço. Separando os dois, a
     caixa de fora chega a 0px de verdade e o padding vai com ela. */
  .stores__unit-body-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding-top: var(--space-list);
    padding-left: var(--space-2xs);
    padding-bottom: 0.375rem;
    font-size: var(--fs-card);
    line-height: 1.5;
    color: var(--color-label);
  }

  /* Abertura suave: `.stores__unit-body` (sem padding próprio, ver acima)
     anima `max-height` de 0 até a altura de verdade (`--corpo-altura`,
     medida no script) — não `grid-template-rows` fr, a receita antiga daqui
     e do FAQ (trocada nos dois pelo mesmo motivo, ver o comentário lá):
     este acordeão é exclusivo, então abrir uma cidade fecha outra ao MESMO
     tempo, e a fr trava perto do fim enquanto `content-visibility` segue
     "visible" de propósito (para o texto encolher junto em vez de sumir de
     uma vez) — visível bem mais aqui do que numa unidade sozinha, porque a
     vizinha está abrindo ao lado no mesmo instante. `content-visibility`
     continua garantindo que o conteúdo fechado não fique focável nem seja
     lido por leitor de tela. */
  @media (prefers-reduced-motion: no-preference) {
    .stores__unit::details-content {
      content-visibility: hidden;
      transition: content-visibility 260ms allow-discrete;
    }

    .stores__unit[open]::details-content {
      content-visibility: visible;
    }

    .stores__unit-body {
      overflow: hidden;
      max-height: 0;
      transition: max-height 260ms ease;
    }

    .stores__unit[open] .stores__unit-body {
      max-height: var(--corpo-altura, 30rem);
    }
  }
</style>

<script>
  /* Altura real de cada corpo do acordeão, guardada em `--corpo-altura`
     (ver o comentário longo junto de `.stores__unit-body` no CSS acima):
     `scrollHeight` mede o conteúdo de verdade mesmo com a caixa clicada em
     0 pelo `max-height`. Refeita no resize — a quebra de linha do endereço
     muda com a largura — e depois que as fontes carregam, porque medir
     antes disso pega o texto ainda no fallback, mais largo ou mais estreito
     que o Poppins final. */
  const definirAlturas = () => {
    document.querySelectorAll<HTMLElement>('.stores__unit-body').forEach((corpo) => {
      corpo.style.setProperty('--corpo-altura', `${corpo.scrollHeight}px`);
    });
  };
  definirAlturas();
  window.addEventListener('resize', definirAlturas);
  document.fonts?.ready.then(definirAlturas);
</script>
