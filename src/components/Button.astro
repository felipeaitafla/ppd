---
/* Componente "BTN" do Figma (node 45:43): seta diagonal + texto em linha,
   gap 8px, ícone de 9px, Poppins 16px/400 em #A8A8A8. É um desenho só —
   as instâncias antigas espalhadas pelas seções (seta de 17px, gap 4px,
   texto menor e mais escuro) são o que ele veio substituir.
   Sem href renderiza <p>: mesmo traço visual sem ser um link, para quando
   o destino ainda não existe.
   `newTab` abre em nova aba e avisa o leitor de tela — o aviso é texto
   escondido, não visual, porque o Figma não desenha ícone para isso. */
import ArrowIcon from './ArrowIcon.astro';

interface Props {
  href?: string;
  newTab?: boolean;
}

const { href, newTab = false } = Astro.props;
---

{href ? (
  <a
    href={href}
    class="btn"
    target={newTab ? '_blank' : undefined}
    rel={newTab ? 'noopener noreferrer' : undefined}
  >
    <ArrowIcon /><slot />{newTab && <span class="visually-hidden"> (abre em nova aba)</span>}
  </a>
) : (
  <p class="btn"><ArrowIcon /><slot /></p>
)}

<style>
  .btn {
    display: flex;
    align-items: center;
    gap: max(.375rem, 0.188vw + .331rem); /* 8px @1440 — escala fluida sem teto, ver CLAUDE.md */
    font-size: var(--fs-card);
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: -0.03em;
    color: var(--color-label);
  }

  a.btn:hover {
    color: var(--color-black);
  }
</style>
