---
import '../styles/global.css';
import 'lenis/dist/lenis.css';
import { Font, getImage } from 'astro:assets';
import SchemaOrg from '../components/SchemaOrg.astro';
import shareSource from '../assets/hero-bg.jpg';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

/* Imagem de compartilhamento (WhatsApp, redes, prévia de link nas IAs): a
   foto do hero recortada em 1200×630. É provisória — uma arte com a marca
   faria melhor; quando vier, troca o import acima. */
const share = await getImage({ src: shareSource, width: 1200, height: 630, fit: 'cover', format: 'jpeg' });
const shareUrl = new URL(share.src, Astro.site).href;
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <Font cssVariable="--font-poppins" preload />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Pede Pro Dindo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Clientes sendo atendidos no balcão de uma loja Pede Pro Dindo" />
    <meta name="twitter:card" content="summary_large_image" />

    <SchemaOrg />
  </head>
  <body>
    <slot />

    <script>
      import Lenis from 'lenis';

      const lenis = new Lenis({
        lerp: 0.06,
        wheelMultiplier: 0.85,
        duration: 1.8,
        easing: (t: number) => 1 - Math.pow(1 - t, 5),
      });

      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }

      requestAnimationFrame(raf);
    </script>
  </body>
</html>
