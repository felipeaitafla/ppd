---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Revelacao from '../components/Revelacao.astro';
import CircularEconomy from '../components/CircularEconomy.astro';
import Stores from '../components/Stores.astro';
import Testimonials from '../components/Testimonials.astro';
import AppleVerified from '../components/AppleVerified.astro';
import Instagram from '../components/Instagram.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Pede Pro Dindo | Revenda Autorizada Apple e economia circular"
  description="A primeira Revenda Autorizada da Apple no Brasil especializada em economia circular. Compre, troque ou venda iPhones seminovos revisados e com garantia."
>
  <main>
    {/* O hero entra sozinho e rola 1:1: o manifesto saiu do site (Figma,
        2026-09-03) e o texto dele desceu para dentro do próprio hero, então
        a abertura — que existia para prender um enquanto o outro passava por
        cima — ficou sem o segundo andar e saiu da página. `Abertura.astro` e
        `Intro.astro` seguem no repositório, sem ninguém que os importe, como
        implementação de referência do efeito (ver CLAUDE.md). */}
    <Hero />

    {/* Passagem normal, sem efeito: as duas rolam 1:1, uma atrás da outra.
        A revelação em camadas que morava aqui saiu em 2026-09-04, a pedido do
        Felipe — desde que a economia circular virou branca, tampa e fundo
        tinham a mesma cor e o que se via era um texto branco escorregando
        sobre outro, sem a borda que dava sentido ao efeito. */}
    <CircularEconomy />
    <Stores />

    <Testimonials />
    <AppleVerified />
    <Instagram />
  </main>

  {/* O FAQ tapa o rodapé e sai da frente dele na rolagem — a única
      revelação em camadas que restou na página, e de propósito mais leve
      que o padrão (profundidade 0.6, contra o teto 1), porque esta é só a
      transição normal de fim de página. Aqui a camada continua legível
      porque as duas seções são escuras em tons diferentes. Nenhuma das duas
      sabe da outra; ver "Vocabulário de efeitos de rolagem" no CLAUDE.md. */}
  <Revelacao alvo="rodape" profundidade={0.6} corVao="var(--color-bg-dark)">
    <Faq slot="tampa" />
    <Footer slot="fundo" />
  </Revelacao>
</Layout>
